<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ttt_engine</name>
  <version>0.1.0</version>
  <description>Judge-driven match engine for the Tic-Tac-Toe final project</description>
  <maintainer email="xingxin.he@connect.ust.hk">ISDN3000E TA</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ttt_game</exec_depend>
  <exec_depend>ttt_interfaces</exec_depend>
  <exec_depend>ttt_layout</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
